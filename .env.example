# SOS MOBILITÉ — variables d'environnement (copier en .env.local)
# Projet Supabase : Settings → API
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Clé publique « anon » uniquement. Ne JAMAIS mettre la clé service_role ici :
# toute variable VITE_* est visible dans le navigateur.
VITE_SUPABASE_ANON_KEY=

# Connexion par SMS (OTP). Activer seulement après configuration d'un
# fournisseur SMS dans Supabase (Authentication → Providers → Phone).
VITE_ENABLE_PHONE_AUTH=false

# URL publique de l'application (redirections e-mail : confirmation, mot de passe)
VITE_APP_URL=http://localhost:5173
